{
  "schema": 1,
  "id": "minimal_keynote",
  "version": "1.0.0",
  "name": "Minimal Keynote",
  "label": {"zh": "极简发布会", "en": "Minimal Keynote"},
  "description": "One idea per page, generous whitespace and very large hierarchy for launches and strategy talks.",
  "extends": null,
  "colors": {
    "background": "FAFAF8",
    "surface": "F3F5F8",
    "text": "16191D",
    "muted": "6B7078",
    "accent": "7496D5",
    "accent_soft": "E4EBFA",
    "card": "F3F5F8",
    "border": "E2E4E8",
    "highlight": "C9A227",
    "positive": "3F7D5A",
    "negative": "A8453C",
    "warning": "9A6B18",
    "chart_series": ["7496D5", "9FB0C6", "C9A227", "8FA98D", "6F6F7A", "B9C6D8"]
  },
  "fonts": {"title": "Noto Sans CJK SC", "body": "Noto Sans CJK SC", "fallback": ["Noto Sans CJK JP", "DejaVu Sans"]},
  "type_scale": {
    "cover_title": {"size": 52, "bold": true, "color_token": "text", "line_height": 1.1, "font": "title"},
    "section_title": {"size": 40, "bold": true, "color_token": "text", "line_height": 1.15, "font": "title"},
    "slide_title": {"size": 34, "bold": true, "color_token": "text", "line_height": 1.2, "font": "title"},
    "statement": {"size": 44, "bold": true, "color_token": "text", "line_height": 1.2, "font": "title"},
    "card_title": {"size": 22, "bold": true, "color_token": "text", "line_height": 1.2, "font": "title"},
    "body": {"size": 22, "bold": false, "color_token": "text", "line_height": 1.4},
    "body_small": {"size": 17, "bold": false, "color_token": "text", "line_height": 1.35},
    "caption": {"size": 11, "bold": false, "color_token": "muted", "line_height": 1.25},
    "kicker": {"size": 11, "bold": true, "color_token": "muted", "line_height": 1.2, "letter_spacing": 2.0},
    "metric": {"size": 56, "bold": true, "color_token": "text", "line_height": 1.0, "font": "title"},
    "metric_label": {"size": 14, "bold": false, "color_token": "muted", "line_height": 1.25},
    "table_header": {"size": 14, "bold": true, "color_token": "text", "line_height": 1.2},
    "table_cell": {"size": 14, "bold": false, "color_token": "text", "line_height": 1.3}
  },
  "spacing": {"margin_x": 0.09, "margin_y": 0.08, "gutter": 0.035, "card_padding": 0.02, "footer_y": 0.88},
  "shape": {"corner_radius_in": 0.04, "line_width_pt": 1.0, "shadow": false, "accent_rule": false},
  "density": {"level": "minimal", "max_bullets": 5, "max_modules": 3, "max_chars_per_line": 32},
  "charts": {"legend_position": "bottom", "gridlines": false, "label_size": 12, "gap_width": 80, "line_width_pt": 3.0},
  "tables": {"header_fill_token": "surface", "header_text_token": "text", "border_token": "border", "font_size": 14, "zebra": false},
  "layouts": {"allowed": "*", "preferred": ["cover", "statement", "hero", "title_body", "three_columns", "kpi"]},
  "components": {"enabled_categories": ["process", "architecture", "bento", "infographic", "illustration", "icons"], "allowed_ids": "*"},
  "quality": {"min_font_pt": 10, "min_contrast": 3.0, "min_contrast_normal": 4.5, "safe_area": true}
}
